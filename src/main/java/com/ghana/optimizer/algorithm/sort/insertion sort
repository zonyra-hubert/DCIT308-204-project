package com.ghana.optimizer;

import java.util.Arrays;
import java.util.Comparator;

/**
 * Stable, in-place Insertion Sort — implemented from scratch (no
 * Arrays.sort / Collections.sort) for the sorting engine module.
 *
 * Generic over T + Comparator, so the SAME method sorts:
 *   - a full array of requests, or
 *   - just a small partition [low..high] of a larger array — the
 *     "small partition" base case inside MergeSort / QuickSort.
 *
 * Complexity
 *   Time  : best  O(n)    input already sorted -> inner while never runs
 *           worst/avg O(n^2)  reverse-sorted / random input
 *   Space : O(1) extra  -> in-place; only 'key' and 'j' beyond the array
 *
 * Stability
 *   The inner loop shifts an element only when it is STRICTLY greater
 *   than the key (comparator result > 0). Equal-priority requests are
 *   never shifted past one another, so two requests at the same
 *   priority_level keep the order they had in the input array.
 */
public class InsertionSort {

    /** Sorts the whole array. Use this in the real program (no console output). */
    public static <T> void sort(T[] arr, Comparator<T> comparator) {
        sort(arr, 0, arr.length - 1, comparator);
    }

    /** Sorts only arr[low..high] inclusive — the "small partition" form. */
    public static <T> void sort(T[] arr, int low, int high, Comparator<T> comparator) {
        for (int i = low + 1; i <= high; i++) {
            T key = arr[i];
            int j = i - 1;
            while (j >= low && comparator.compare(arr[j], key) > 0) {
                arr[j + 1] = arr[j];
                j--;
            }
            arr[j + 1] = key;
        }
    }

    /**
     * Same algorithm as sort(), but prints a pass-by-pass trace to
     * System.out — this is what generates the trace-table evidence the
     * project brief asks for. Run it on your real loaded service_requests
     * array (or any slice of it) to produce report-ready trace output.
     */
    public static <T> void sortWithTrace(T[] arr, int low, int high, Comparator<T> comparator) {
        System.out.println("Start: " + Arrays.toString(Arrays.copyOfRange(arr, low, high + 1)));
        for (int i = low + 1; i <= high; i++) {
            T key = arr[i];
            int j = i - 1;
            StringBuilder log = new StringBuilder();
            while (j >= low && comparator.compare(arr[j], key) > 0) {
                log.append(arr[j]).append(">key shift; ");
                arr[j + 1] = arr[j];
                j--;
            }
            if (log.length() == 0) log.append("no shift; ");
            arr[j + 1] = key;
            System.out.println("Pass " + (i - low) + "  key=" + key + "  " + log
                + "insert@" + (j + 1) + "  ->  " + Arrays.toString(Arrays.copyOfRange(arr, low, high + 1)));
        }
    }

    public static void main(String[] args) {
        ServiceRequest[] requests = {
            new ServiceRequest(501, "LOC-UG-09", "Electrical circuit fault - Block C", 2, 180.00, 3.5, "OPEN"), // Commonwealth Hall
            new ServiceRequest(502, "LOC-UG-06", "Plumbing leak - Block A", 1, 95.50, 2.0, "OPEN"),             // Akuafo Hall
            new ServiceRequest(503, "LOC-UG-21", "Peak-hour shuttle queue override", 1, 0.00, 0.5, "OPEN"),     // Main Gate Stop
            new ServiceRequest(504, "LOC-UG-01", "Archive transfer to ISSER", 3, 60.00, 4.0, "OPEN"),           // Balme Library
            new ServiceRequest(505, "LOC-UG-10", "Water tank valve overhaul", 2, 210.00, 5.0, "OPEN")           // Mensah Sarbah Hall
        };

        System.out.println("Before: " + Arrays.toString(requests));
        sortWithTrace(requests, 0, requests.length - 1, Comparator.comparingInt(r -> r.priorityLevel));
        System.out.println("After:  " + Arrays.toString(requests));
    }
}

/**
 * Matches the real service_requests table:
 * (id, location_id, description, priority_level, budget_required,
 *  estimated_duration_hrs, status)
 */
class ServiceRequest {
    int id;
    String locationId;
    String description;
    int priorityLevel;        // 1 = most urgent ... 5 = least urgent (flip with .reversed() if your scale runs the other way)
    double budgetRequired;    // GHS
    double estimatedDurationHrs;
    String status;

    ServiceRequest(int id, String locationId, String description, int priorityLevel,
                   double budgetRequired, double estimatedDurationHrs, String status) {
        this.id = id;
        this.locationId = locationId;
        this.description = description;
        this.priorityLevel = priorityLevel;
        this.budgetRequired = budgetRequired;
        this.estimatedDurationHrs = estimatedDurationHrs;
        this.status = status;
    }

    @Override
    public String toString() {
        return "#" + id + "(P" + priorityLevel + ")";
    }
}